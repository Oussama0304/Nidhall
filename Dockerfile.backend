FROM node:20-alpine

WORKDIR /app

# Installation des dépendances système nécessaires
RUN apk add --no-cache curl netcat-openbsd

# Installation des dépendances Node.js
COPY package*.json ./
RUN npm ci --only=production

# Copie des fichiers du projet
COPY . .

# Créer le script d'entrée
RUN echo '#!/bin/sh' > /app/docker-entrypoint.sh && \
    echo 'set -e' >> /app/docker-entrypoint.sh && \
    echo 'echo "Waiting for MySQL to be ready..."' >> /app/docker-entrypoint.sh && \
    echo 'timeout=30' >> /app/docker-entrypoint.sh && \
    echo 'while [ $timeout -gt 0 ]; do' >> /app/docker-entrypoint.sh && \
    echo '    if nc -z db 3306; then' >> /app/docker-entrypoint.sh && \
    echo '        echo "MySQL is ready!"' >> /app/docker-entrypoint.sh && \
    echo '        break' >> /app/docker-entrypoint.sh && \
    echo '    fi' >> /app/docker-entrypoint.sh && \
    echo '    echo "Waiting for MySQL... ($timeout seconds left)"' >> /app/docker-entrypoint.sh && \
    echo '    timeout=$((timeout-1))' >> /app/docker-entrypoint.sh && \
    echo '    sleep 1' >> /app/docker-entrypoint.sh && \
    echo 'done' >> /app/docker-entrypoint.sh && \
    echo 'if [ $timeout -eq 0 ]; then' >> /app/docker-entrypoint.sh && \
    echo '    echo "Timeout waiting for MySQL"' >> /app/docker-entrypoint.sh && \
    echo '    exit 1' >> /app/docker-entrypoint.sh && \
    echo 'fi' >> /app/docker-entrypoint.sh && \
    echo 'exec node server.js' >> /app/docker-entrypoint.sh && \
    chmod +x /app/docker-entrypoint.sh

EXPOSE 3000

CMD ["/app/docker-entrypoint.sh"]
